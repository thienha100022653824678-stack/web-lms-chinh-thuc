# Required LMS server configuration. Store real values in Vercel or another
# approved secret store; never commit them.
SUPABASE_URL=REPLACE_IN_SECRET_STORE
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECRET_STORE
SESSION_SECRET=REPLACE_IN_SECRET_STORE
ADMIN_EMAILS=REPLACE_IN_SECRET_STORE
INTERNAL_SYNC_SECRET=REPLACE_IN_SECRET_STORE
GOOGLE_CLIENT_ID=REPLACE_IN_SECRET_STORE
GOOGLE_CLIENT_SECRET=REPLACE_IN_SECRET_STORE

# Dual LMS rollout flag. Keep false until an approved rollout gate.
LMS_DUAL_SYSTEM_ENABLED=false
