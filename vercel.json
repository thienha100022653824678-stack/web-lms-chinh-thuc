{
  "rewrites": [
    { "source": "/admin.html", "destination": "/admin-v3-shell.html" },
    { "source": "/learning", "destination": "/learning.html" },
    { "source": "/v3", "destination": "/v3.html" },
    { "source": "/v3-admin", "destination": "/v3-admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
