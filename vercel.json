{
  "buildCommand": "npm run build:v5:bundle",
  "outputDirectory": "dist-v5",
  "rewrites": [
    { "source": "/v5", "destination": "/v5.html" },
    { "source": "/v5/", "destination": "/v5.html" },
    { "source": "/v5-admin", "destination": "/v5-admin.html" },
    { "source": "/v5-admin/", "destination": "/v5-admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
